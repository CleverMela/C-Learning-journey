#include<stdio.h>

int main(){
	
	int hour1,minute1;
	int hour2,minute2;
	
	printf("请输入开始时间的小时和分钟，例如输入\"11 20\"表示11时20分：");
	scanf("%d %d",&hour1,&minute1);
	
	printf("请输入结束时间的小时和分钟，例如输入\"11 20\"表示11时20分：");
	scanf("%d %d",&hour2,&minute2);
	
	int ih=hour2-hour1;
	int im=minute2-minute1;
	
	if(im<0){
		im=60+im;
		ih=ih-1;
	}
	printf("时间差是%d小时%d分钟。\n",ih,im);
	
	return 0;
}
