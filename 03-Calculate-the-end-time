#include<stdio.h>

int main(){
	
	int time1=0;
	int period=0;
	
	printf("请输入开始时间，如输入\"1120\"表示11时20分");
	scanf("%d",&time1);
	printf("请输入经过时间，如输入\"110\"表示经过110分钟");
	scanf("%d",&period);
	
	int time0=time1/100*60+time1%100;
	int time3=time0+period;
	int finish=time3/60*100+time3%60;
	
	printf("结束时间为%d",finish);
	
	return 0;
}
